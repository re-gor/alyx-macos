 /* == D3D11 producer thunks ================================================= */
+template<typename Desc>
+bool producer_defined_initial_data(const Desc& desc, bool has_output,
+                                   D3D11_SUBRESOURCE_DATA* data) {
+    // A producer created without initial data can defer its first zero-fill
+    // until GPU use, after another process has already written the allocation.
+    // Mark supported single-surface colour textures defined using the same
+    // intercepted sentinel upload as imports. Preserve caller data and shapes
+    // whose mip/slice/sample layout this adapter cannot reproduce.
+    if (!has_output || desc.MipLevels != 1 || desc.ArraySize != 1 ||
+        desc.SampleDesc.Count != 1 || desc.Usage != D3D11_USAGE_DEFAULT ||
+        !desc.Width || !desc.Height)
+        return false;
+    uint32_t support = 0;
+    if (!dmn_format_support((uint32_t)desc.Format, &support) ||
+        !(support & DMN_FMT_SUPPORT_RENDER_TARGET))
+        return false;
+    // Sixteen bytes is the maximum texel size for these colour formats.
+    // A conservative padded pitch avoids duplicating the Metal format table.
+    // Keep even an unintercepted upload within the sentinel's readable span.
+    constexpr uint64_t sentinel_span = uint64_t(256) << 20;
+    const uint64_t pitch = uint64_t(desc.Width) * 16;
+    uint64_t span = 0;
+    if (pitch > UINT32_MAX ||
+        __builtin_mul_overflow(pitch, uint64_t(desc.Height), &span) ||
+        span > sentinel_span)
+        return false;
+    const void* sentinel = dmn_share_init_data_sentinel();
+    if (!sentinel) return false;
+    data->pSysMem = sentinel;
+    data->SysMemPitch = (UINT)pitch;
+    data->SysMemSlicePitch = (UINT)span;
+    return true;
+}
